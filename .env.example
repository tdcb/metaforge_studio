# ===========================================================================
# MetaForge Studio — Sample Environment Configuration (.env.example)
# ===========================================================================
# Copy this file to `.env` (which is ignored by Git via `.gitignore`) to set
# local environment variables without ever committing secrets to version control:
#
#   cp .env.example .env
#
# Note: Individual users can also save their own private Gemini API key
# directly in the Studio UI (Profile Menu -> AI API Keys), which is stored
# per-user in the gitignored local SQLite database.
# ===========================================================================

# JWT Signing Secret (if left empty, an ephemeral cryptographic key is generated on startup)
METAFORGE_JWT_SECRET=
METAFORGE_JWT_EXPIRE_MINUTES=1440

# Metadata Control Plane Database URL (defaults to local SQLite if left empty)
METAFORGE_DATABASE_URL=

# Google Gemini API Configuration (Optional fallback if not configured per-user in UI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-Compatible / Built-in LLM Configuration (Optional)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
